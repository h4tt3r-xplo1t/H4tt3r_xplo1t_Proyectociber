{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(git status)", "Bash(git diff *)", "Bash(git log *)",
      "Bash(git switch *)", "Bash(git add *)", "Bash(git commit *)",
      "Bash(gh issue view *)", "Bash(gh issue list *)",
      "Bash(uv sync --locked)", "Bash(uv run --locked pytest *)",
      "Bash(uv run --locked ruff check *)", "Bash(uv run --locked ruff format --check *)"
    ],
    "ask": [
      "Bash(git push *)", "Bash(gh pr create *)",
      "Bash(pip install *)", "Bash(npm install *)", "WebFetch"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(./secrets/**)",
      "Bash(git push --force *)", "Bash(git reset --hard *)",
      "Bash(rm -rf *)", "Bash(curl *)", "Bash(wget *)",
      "Bash(gh repo delete *)", "Bash(gh secret *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guardia.sh" }
        ]
      }
    ]
  }
}
