# Valores FICTICIOS. Copia a .env (no versionado) y usa valores reales desde el gestor de secretos.
APP_SECRET=CAMBIAR-NO-USAR

# --- gateway (issue #29) ---
# Fake values, not usable anywhere. Export real local ones in your shell.
POSTGRES_USER=gateway
POSTGRES_PASSWORD=CHANGE_ME_not_a_real_password
POSTGRES_DB=gateway_test
GATEWAY_DATABASE_URL=postgresql+psycopg://gateway:CHANGE_ME_not_a_real_password@127.0.0.1:5432/gateway_test
GATEWAY_OPENBAO_ADDR=http://127.0.0.1:8200
GATEWAY_OPENBAO_ROLE_ID_FILE=.local/openbao/role-id
GATEWAY_OPENBAO_SECRET_ID_FILE=.local/openbao/secret-id
